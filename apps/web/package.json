    "valibot": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@market/config": "workspace:*",
    "@types/geojson": "^7946.0.16",
    "@types/mapbox-gl": "^3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "madge": "^8.0.0",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.14",
